# Orbit agent, on a host managed by Orbit. One instance PER NETWORK.
#
# Install to /etc/systemd/system/orbit-agent@.service, then:
#   systemctl enable --now orbit-agent@prod
#
# %i is the network's slug, and it is the same %i as nebula@%i.service: the two
# units share exactly one directory, /var/lib/orbit/%i, and nothing else. A host
# on two networks runs two of each.
#
# Enroll once by hand before enabling this:
#   orbit-agent enroll -network prod \
#       -url https://orbit.example.com -code orb_1_… \
#       -reload "systemctl reload nebula@prod"

[Unit]
Description=Orbit agent (%i)
After=network-online.target nebula@%i.service
Wants=network-online.target
# Deliberately not Requires=: the agent failing must never stop nebula, and an
# agent that cannot reach the control plane is a degraded state, not an outage.
# Existing tunnels keep working and the host keeps its certificate until expiry.
#
# The After= names THIS instance. Ordering against the bare nebula.service, or
# against every instance, would make one network's data plane a scheduling
# dependency of another network's agent.

[Service]
Type=exec
# -dir, not -network, so the unit states the layout once and the flag cannot
# disagree with StateDirectory= below. -network prod would expand to the same
# path; either is accepted, both together only if they agree.
#
# -restart names THIS instance. A bare "systemctl restart nebula" would restart
# the wrong network's data plane, or none, on a host with more than one.
# It is also what lets the agent see whether nebula is running at all: without
# it, a nebula that cannot start is invisible to the agent and to the control
# plane.
ExecStart=/usr/local/bin/orbit-agent run \
    -dir /var/lib/orbit/%i \
    -mode authoritative \
    -reload "systemctl reload nebula@%i" \
    -restart "unit:nebula@%i" \
    -verify-url http://10.42.0.2:8443/agent/v1/state

Restart=always
RestartSec=30s

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
# The same directory nebula@%i.service declares. Everything the agent writes
# lives here rather than in /etc, so an image-based system (bootc, OSTree) does
# not reconcile runtime state away on upgrade. See the comment in
# nebula@.service.
StateDirectory=orbit/%i

[Install]
WantedBy=multi-user.target
