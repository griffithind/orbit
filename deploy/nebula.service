# Nebula, on a host managed by Orbit.
#
# Install to /etc/systemd/system/nebula.service
#
# Orbit's agent writes /var/lib/nebula/config.d/50-orbit.yml and signals this
# unit. Anything you maintain yourself goes in another file in that directory —
# 00-base.yml by convention — and nebula merges them. Note that nebula APPENDS
# list values across files, so firewall rules from both apply.
#
# /var/lib rather than /etc because every file in there is written at runtime by
# the agent: the certificate, the key, the rendered fragment, and the previous
# generation kept for rollback. On an image-based system (bootc, OSTree, Fedora
# CoreOS) /etc is an overlay the image reconciles on upgrade, and state written
# there can be reverted underneath a running host. StateDirectory= below is the
# idiomatic way to get /var/lib/nebula created with the right ownership, and it
# works on a read-only /usr.

[Unit]
Description=Nebula overlay network
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main

# The whole config directory, not a single file. This is what makes the split
# between operator-owned and Orbit-owned configuration work.
ExecStart=/usr/local/bin/nebula -config /var/lib/nebula/config.d

# SIGHUP is nebula's reload: hot, and tunnels survive it. The agent sends this
# for a certificate renewal or a configuration change. It cannot be used for a
# changed overlay address; the agent detects that and asks for a restart
# instead.
ExecReload=/bin/kill -HUP $MAINPID

Restart=always
RestartSec=5s

# Needs CAP_NET_ADMIN for the tun device, and nothing else.
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
# Creates and owns /var/lib/nebula, and implies write access to it. Shared with
# orbit-agent.service, which declares the same directory.
StateDirectory=nebula

[Install]
WantedBy=multi-user.target
