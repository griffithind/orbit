# Copy to deploy/.env and fill in. Never commit the filled version.

# Postgres. Both are generated once and never typed again.
#   head -c 24 /dev/urandom | base64 | tr -d '/+='
POSTGRES_SUPERUSER_PASSWORD=
POSTGRES_APP_PASSWORD=

# Enrollment pepper. Losing it invalidates outstanding enrollment codes, which
# expire in 15 minutes anyway — survivable, unlike losing the CA key.
#   head -c 32 /dev/urandom | base64
ORBIT_ENROLL_PEPPER=

# The public address hosts reach this machine at, as host:port. A lighthouse
# nobody can reach is worse than none, because every host keeps dialling it.
ORBIT_PUBLIC_ADDR=203.0.113.10:4242

# What agents are told to enroll against. Put TLS in front and use https once
# you have a name; over plain http an on-path observer can read an enrollment
# code in transit.
ORBIT_ENROLL_URL=http://203.0.113.10:8080/enroll/v1/enroll

# The control plane's own overlay address, inside the network's CIDR.
ORBIT_OVERLAY_ADDR=10.42.0.1

# Printed by `docker compose run --rm orbitd bootstrap`. Empty until then.
ORBIT_NETWORK=

# For `docker compose run --rm orbit …`, the admin CLI from the same image:
#
#   docker compose run --rm orbit host create -name web-01 -addr 10.42.0.7 -role default
#   docker compose run --rm orbit host code web-01
#
# Optional. Leave empty and pass it per command with -e ORBIT_TOKEN=… if you
# would rather not keep an admin token on the control plane at all — though the
# database password is already in this file.
ORBIT_TOKEN=

# Where that CLI points. The default is the control plane beside it; set this to
# reach a different one.
#ORBIT_ADMIN_URL=http://127.0.0.1:8080

# Pin this. `latest` means a restart can change the version under you.
#
# 0.3.1 is the first release with a published image; on 0.3.0 there is nothing
# to pull and only `docker compose build` works. 0.3.2 is the first where
# `docker compose up` reaches the database at all.
ORBIT_VERSION=0.3.5
