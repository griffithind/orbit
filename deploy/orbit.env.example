# /etc/orbit/orbit.env  —  chmod 0600, owned by root
#
# The CA key passphrase does NOT belong here. It is loaded as a systemd
# credential so it can be sealed to the machine's TPM; see orbit-control.service.

# Connect as orbit_app, never as the migration role: the application must not be
# able to alter the schema or rewrite the audit log.
ORBIT_DSN=postgres://orbit_app:CHANGEME@127.0.0.1:5432/orbit?sslmode=disable

# 32+ random bytes, base64. Keys the stored form of enrollment codes so a
# database leak alone yields none that are usable.
#   head -c 32 /dev/urandom | base64
ORBIT_ENROLL_PEPPER=CHANGEME

# The network orbitd joins, from `orbitd bootstrap` output.
ORBIT_NETWORK=00000000-0000-0000-0000-000000000000
