# Orbit agent, on a host managed by Orbit.
#
# Install to /etc/systemd/system/orbit-agent.service
#
# Enroll once by hand before enabling this:
#   orbit-agent enroll -url https://orbit.example.com -code orb_1_… \
#       -reload "systemctl reload nebula"

[Unit]
Description=Orbit agent
After=network-online.target nebula.service
Wants=network-online.target
# Deliberately not Requires=: the agent failing must never stop nebula, and an
# agent that cannot reach the control plane is a degraded state, not an outage.
# Existing tunnels keep working and the host keeps its certificate until expiry.

[Service]
Type=exec
ExecStart=/usr/local/bin/orbit-agent run \
    -dir /var/lib/nebula \
    -reload "systemctl reload nebula" \
    -restart "systemctl restart nebula" \
    -verify-url http://10.42.0.2:8443/agent/v1/state

Restart=always
RestartSec=30s

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
# The same directory nebula.service declares. Everything the agent writes lives
# here rather than in /etc, so an image-based system (bootc, OSTree) does not
# reconcile runtime state away on upgrade. See the comment in nebula.service.
StateDirectory=nebula

[Install]
WantedBy=multi-user.target
