# Build output. Anchored to the root: unanchored "orbitd" would also match
# cmd/orbitd, which is source.
/bin/
/orbit
/orbitd
/orbit-agent
/orbit-migrate
/interop

# Local secrets and state. A CA key must never reach a commit.
*.key
*.crt
*.pem
*.cred
*.env
!deploy/orbit.env.example

# What scripts/setup-control-plane.sh writes, and it writes them INSIDE a clone
# — it checks the repository out to /opt/orbit and compose needs ./ca-pass
# beside the compose file. So a `git add -A` on the server would otherwise
# commit the mesh's CA passphrase and both admin tokens.
# No longer written — ORBIT_CA_KEY_PASSPHRASE_FILE was a dead alias for the KEK
# — but kept so a control plane set up before that does not start offering it.
/deploy/ca-pass
/deploy/bootstrap-output.txt

# Local data
/var/
*.sql.age

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/
